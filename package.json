{
  "name": "luxtips",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:legacy && npm run test:production",
    "check": "node scripts/check.mjs && node scripts/check-production.mjs",
    "probe:openfoot": "node scripts/probe-openfoot.mjs",
    "test:legacy": "node --test tests/*.test.mjs",
    "test:production": "node --test production/tests/*.test.mjs",
    "check:production": "node scripts/check-production.mjs",
    "build:check": "wrangler deploy --dry-run --outdir dist"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "wrangler": "4.151.3"
  }
}
